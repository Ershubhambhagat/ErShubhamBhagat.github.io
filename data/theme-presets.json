{
  "_guide": [
    "// theme-presets.json - palettes offered by the Theme Studio.",
    "// schemaVersion: always 1. It tells the loader which shape to expect; do not change it.",
    "// REQUIRED per theme: id, name. mode is 'dark' or 'light'.",
    "// tokens: only the colour tokens below may be overridden; anything else is ignored.",
    "//   --color-primary, --color-primary-contrast, --color-secondary, --color-accent,",
    "//   --color-background, --color-surface, --color-surface-raised, --color-overlay,",
    "//   --color-text-primary, --color-text-secondary, --color-text-muted, --color-border,",
    "//   --color-focus-ring, --color-success, --color-warning, --color-danger",
    "// values: hex (#7c8cff), rgb()/rgba(), hsl()/hsla() or a CSS colour keyword.",
    "//        url() and var() chains are rejected so a preset cannot inject other properties.",
    "// swatches: optional three colours for the preview dots when tokens is empty.",
    "// Empty tokens means the theme falls back to css/variables.css defaults."
  ],
